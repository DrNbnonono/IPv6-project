# 服务器配置
PORT=3000
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=ipv6_project

# JWT配置（必填，未配置时服务无法启动；不再有默认值）
# 生成方式: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key

# 跨域与安全
# 允许的前端来源（逗号分隔）。未配置时放行所有来源，生产环境请务必设置
# CORS_ORIGINS=http://localhost:5173,https://your-domain.example
# 部署在反向代理（nginx/容器网关）之后时设置代理层数，使限流按真实客户端 IP 统计
# TRUST_PROXY=1
# 请求体大小限制：默认 2mb；/api/jsonanalysis 使用 LARGE_BODY_LIMIT
# BODY_LIMIT=2mb
# LARGE_BODY_LIMIT=50mb
# 限流：登录失败 LOGIN_RATE_MAX 次 / LOGIN_RATE_WINDOW_MIN 分钟；全局 API_RATE_MAX 次/分钟
# LOGIN_RATE_MAX=10
# LOGIN_RATE_WINDOW_MIN=15
# API_RATE_MAX=600
# AI 问答（/api/ai/detection/chat，面向未登录访客，消耗大模型额度）单独限流：每 IP 每分钟次数，以及单条问题最大字数
# AI_RATE_MAX=20
# AI_MESSAGE_MAX_CHARS=2000
# 数据目录根（xmap_log、zgrab2_inputs、whitelists 等都在其下），默认为仓库根目录
# 容器或换目录部署时设置；旧数据库记录里的 /home/ipv6/IPv6-project 前缀见 scripts/rebaseStoredPaths.js
# PROJECT_ROOT=
# 终端可访问的目录范围（默认仓库根目录）
# TERMINAL_JAIL_ROOT=

# 密码哈希
# bcrypt 加密强度，默认 10
# BCRYPT_ROUNDS=10
# 是否兼容尚未迁移的明文密码（登录成功后会自动升级为哈希）。
# 执行 node scripts/migratePasswords.js 后请设置为 false
# ALLOW_LEGACY_PASSWORDS=true

# ============================================
# AI服务配置（Detection 页面的 IPv6 专家问答 和 Agent 共用同一套配置，都经 llmService 调用）
# ============================================

# AI服务提供商: minimax | deepseek | openai | siliconflow | custom
# 不设置时，选第一个配置了密钥的（按 minimax、deepseek、openai、siliconflow、custom 的顺序），都没有则 minimax。
# AI_MODEL / AI_API_BASE_URL 对 deepseek、openai、siliconflow、custom 都生效；提供商专用的变量
# （如 DEEPSEEK_MODEL、DEEPSEEK_BASE_URL）优先。MiniMax 用 MINIMAX_API_KEY / MINIMAX_MODEL / MINIMAX_BASE_URL。
AI_PROVIDER=deepseek

# API密钥 (必填)
# DeepSeek: https://platform.deepseek.com/
# OpenAI: https://platform.openai.com/
# 硅基流动: https://siliconflow.cn/
AI_API_KEY=your_api_key_here

# 或者使用特定提供商的密钥名称
# DEEPSEEK_API_KEY=sk-xxxxxxxx

# 自定义API配置 (可选，用于自定义API端点)
# AI_API_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

# Agent 工具调用：默认使用模型的原生工具调用（tool_use / function calling），由模型决定是否调用工具、参数是什么；
# 调用扫描、终端等有副作用的工具时仍然只返回“待确认”请求，必须由用户在界面上确认才会执行。
# 设为 false 退回关键词 + 正则的意图识别（多一次模型调用，识别较粗）。提供商以 400/404/422 拒绝带工具的请求时也会自动退回。
# AGENT_NATIVE_TOOLS=true
# 模型一次回复里最多处理几个工具调用（1–10，默认 3），多出来的不处理并告知用户。
# AGENT_MAX_TOOL_CALLS=3

# 知识库：默认索引 backend/knowledge、docs/xmap、docs/zgrab2。需要先执行迁移 14（要求 MySQL 8），再运行 npm run knowledge:index。
# 额外目录（逗号分隔，相对项目根目录或绝对路径），如放项目自己的实验结论：
# KNOWLEDGE_EXTRA_DIRS=

# 每日统计快照（趋势图的数据来源，需先执行迁移 15）：后端每天本地时间 STATS_SNAPSHOT_HOUR 点之后写一次
# （读 countries / asns 上已有的汇总计数，不扫描地址大表）。首次启用想立刻有一个数据点：npm run stats:snapshot。
# STATS_SNAPSHOT_ENABLED=true
# STATS_SNAPSHOT_HOUR=2

# 开放只读 API（/api/open/v1）：需要先执行迁移 16，再由管理员在管理页创建 API 密钥。
# 每把密钥每分钟的请求上限（默认 60），密钥上可单独设置。用法见 backend/knowledge/platform/open-api.md。
# OPEN_API_RATE_PER_MIN=60

# 任务报告（POST /api/reports）保存在 reports/ 目录，保留天数（默认 30），生成新报告时顺带清理。
# 要支持 format=pdf，需要在后端额外 npm install puppeteer；没装时只提供 HTML 报告（浏览器里可直接打印为 PDF）。
# REPORT_RETENTION_DAYS=30

# ============================================
# 常用配置示例
# ============================================

# DeepSeek配置:
# AI_PROVIDER=deepseek
# AI_API_KEY=sk-xxxxxxxx
# AI_MODEL=deepseek-chat

# OpenAI配置:
# AI_PROVIDER=openai
# AI_API_KEY=sk-xxxxxxxx
# AI_MODEL=gpt-3.5-turbo

# 硅基流动配置:
# AI_PROVIDER=siliconflow
# AI_API_KEY=sk-xxxxxxxx
# AI_MODEL=deepseek-ai/DeepSeek-V2.5

# 日志：error / warn / info / debug（默认 info）。原先的调试输出现在是 debug 级别，排查问题时设为 debug。
# 日志同时写入 backend_logs/combined.log 与 error.log；token、密码、Authorization 等会被自动遮蔽。
# LOG_LEVEL=info

# 扫描工具：可执行文件位置。XMAP_USE_SUDO 默认 true（`sudo xmap …`）；
# 在容器里给 xmap 授予 cap_net_raw/cap_net_admin、应用以非 root 运行时设为 false。
# XMAP_BIN=xmap
# XMAP_USE_SUDO=true
# ZGRAB2_BIN=/home/ipv6/go/bin/src/zmap/zgrab2/zgrab2

# 任务并发：创建任务只是入队（pending），由调度器按下列上限启动，超出的排队等待。
# 同类型同时运行的任务数（xmap 默认 2、zgrab2 默认 4）；同一用户在同一类型下同时运行的任务数（默认 3）
# MAX_CONCURRENT_XMAP=2
# MAX_CONCURRENT_ZGRAB2=4
# 其他任务类型：MAX_CONCURRENT_APD（别名前缀检测）、MAX_CONCURRENT_TGA（目标生成）、MAX_CONCURRENT_ENRICH（IID 分类与来源补全），默认 2
# IID 富化任务的分批大小（100–20000，默认 2000）与批间暂停毫秒数（0–5000，默认 20）
# ENRICH_BATCH_SIZE=2000
# ENRICH_BATCH_PAUSE_MS=20
# MAX_CONCURRENT_PER_USER=3

# 扫描策略（默认拒绝）：不配置任何白名单时，所有扫描任务都会被拒绝。
# 允许扫描的地址/CIDR，逗号分隔（管理员也可在 /api/admin/scan-allowlist 里维护，两者取并集）。
# 回环、组播、链路本地（含 169.254.0.0/16 云元数据）等地址无论如何都不允许扫描。
# SCAN_ALLOWED_TARGETS=2001:db8::/32
# xmap / apd 单个任务的速率上限、未指定时的默认速率（bit/s，支持 K/M/G 后缀）、每个用户每天可创建的扫描任务数（xmap + zgrab2 + apd 合计）
# SCAN_MAX_RATE=100M
# SCAN_DEFAULT_RATE=10M
# SCAN_DAILY_LIMIT=100
