# docker compose 使用的环境变量：复制为 .env（已被 .gitignore 忽略，切勿提交）
#   cp .env.docker.example .env

# ---- 必填 ----
MYSQL_ROOT_PASSWORD=change-me-root-password
DB_PASSWORD=change-me-db-password
# JWT 签名密钥：至少 32 位随机字符串，例如 openssl rand -hex 32
JWT_SECRET=

# ---- 可选 ----
# DB_NAME=ipv6_project
# DB_USER=observ6
# 对外端口（nginx）
# FRONTEND_PORT=8080
# 前端与 API 同源（经 nginx 转发）时无需设置；跨域访问时填允许的来源，逗号分隔
# CORS_ORIGINS=
# LOG_LEVEL=info

# ---- 扫描叠加层（docker-compose.scanner.yml）----
# SCANNER_IPV6_SUBNET=fd00:6:6:6::/64
